# SALU environment file. Copy to `.env` (which is git-ignored) and adjust.
# Never commit real secrets. Never put secrets in config/settings.yaml.

# --- Claude authentication -------------------------------------------------
# Default: "subscription" — SALU uses YOUR existing Claude Code login
# (claude.ai Pro/Max via `claude /login`). SALU never reads or stores those
# credentials; the unmodified Claude Code CLI handles them.
# In subscription mode SALU REMOVES ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN
# from its process so usage can never silently switch to API billing.
SALU_CLAUDE_AUTH_MODE=subscription

# Only used if SALU_CLAUDE_AUTH_MODE=api_key (separate pay-as-you-go API
# billing via console.anthropic.com). Leave empty unless you opt in.
# ANTHROPIC_API_KEY=

# Optional: explicit path to the Claude Code CLI (claude.exe).
# SALU_CLAUDE_CLI_PATH=C:\Users\you\.local\bin\claude.exe

# Optional: override the model alias (sonnet / opus / haiku) or full model ID.
# SALU_CLAUDE_MODEL=sonnet

# --- Server ------------------------------------------------------------------
# SALU_PORT=8765
# SALU_LOG_LEVEL=INFO
